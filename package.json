{
  "name": "react-to-uml",
  "version": "2.0.0",
  "main": "lib/index.js",
  "keywords": [
    "react-components-tree",
    "react-to-uml",
    "react-uml",
    "visualize-react-components"
  ],
  "files": [
    "lib"
  ],
  "bin": {
    "react-to-uml": "lib/cli.js"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/mallchel/react-to-uml",
  "author": "sebastianalfabc@gmail.com",
  "description": "Visualize your react components tree with graph diagram",
  "repository": {
    "type": "git",
    "url": "https://github.com/mallchel/react-to-uml"
  },
  "scripts": {
    "sample:app": "rsbuild dev -c ./packages/app/rsbuild.config.ts",
    "sample:gather": "cross-env ENTRY=./packages/app/client.js IS_GATHER_INFO=true node --require tsm ./src/cli.ts",
    "sample:graph": "yarn build:viewer && cross-env ENTRY=./packages/app/client.js IS_BUILD_GRAPH=true node --require tsm ./src/cli.ts --serve",
    "sample": "yarn build:viewer && cross-env ENTRY=./packages/app/client.js node --require tsm ./src/cli.ts --serve",
    "target:gather": "cross-env IS_GATHER_INFO=true node --require tsm ./src/cli.ts",
    "target:graph": "yarn build:viewer && cross-env IS_BUILD_GRAPH=true node --require tsm ./src/cli.ts --serve",
    "target": "yarn build:viewer && node --require tsm ./src/cli.ts --serve",
    "dev:viewer": "rsbuild dev -c ./packages/graph-viewer/rsbuild.config.ts",
    "build:viewer": "rsbuild build -c ./packages/graph-viewer/rsbuild.config.ts",
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build:lib": "tsc --project ./tsconfig.lib.json",
    "build": "yarn clean && yarn build:lib && yarn build:viewer",
    "test": "node --require tsm --test ./src/**/*-test.ts ./packages/**/*-test.js",
    "test:watch": "node --require tsm --test --watch ./src/**/*-test.ts ./packages/**/*-test.js",
    "prepublishOnly": "yarn test && yarn build"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.5.16",
    "@rsbuild/plugin-react": "^1.4.3",
    "@types/babel__traverse": "^7.18.5",
    "@types/node": "^20.5.9",
    "@types/react": "^18.2.46",
    "@types/resolve": "^1.20.6",
    "@ui/kit": "link:./packages/custom-library",
    "cross-env": "^7.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "tsm": "^2.3.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@babel/core": "^7.22.11",
    "@babel/traverse": "^7.21.5",
    "@babel/types": "^7.23.6",
    "resolve": "^1.22.11"
  }
}
